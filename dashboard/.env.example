# Copy this file to ".env.local" and fill in your own lab passwords.
# ".env.local" is ignored by git. Never commit real passwords.
# Use letters and digits only in passwords (no quotes, @, <, >, *).

# Where Oracle listens (Docker maps the container's port 1521 to your Mac)
DB_CONNECT=localhost:1521/FREEPDB1

# Retail application user (owns the retail tables)
APP_USER=retail_app
APP_PASSWORD=

# Read-only monitoring user (can look at Oracle's health views, nothing else)
MON_USER=retail_monitor
MON_PASSWORD=
